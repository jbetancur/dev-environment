# Cluster-wide values — committed with placeholders.
# Copy to user.conf or set as env vars before running cluster.sh.
# Real values are never committed — cluster.sh creates the cluster-values
# ConfigMap imperatively from whatever is sourced at bootstrap time.

ACME_DOMAIN=example.com
ACME_SUBDOMAIN=dev
ACME_WILDCARD=*.dev.example.com
ACME_BASE=dev.example.com
ACME_EMAIL=you@example.com
ARGOCD_REPO_URL=https://github.com/you/dev-environment.git
