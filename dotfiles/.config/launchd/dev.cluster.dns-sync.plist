<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Watches for macOS network configuration changes and syncs /etc/hosts. -->
  <key>Label</key>
  <string>dev.cluster.dns-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>SCRIPTS_DIR/dns-sync.sh</string>
  </array>

  <!-- Fire whenever the network configuration changes (join/leave WiFi, etc.) -->
  <key>WatchPaths</key>
  <array>
    <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
    <string>/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist</string>
  </array>

  <!-- Also run once at load time to sync immediately -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/dns-sync.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/dns-sync.log</string>
</dict>
</plist>
