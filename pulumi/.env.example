STACK=yourname
DOMAIN=example.com
SUBDOMAIN=dev
EMAIL=you@example.com
REPO_URL=https://github.com/you/dev-environment.git

# Cert mode: letsencrypt or selfsigned
# - letsencrypt: valid TLS via Cloudflare DNS-01 (requires CF_TOKEN)
# - selfsigned:  local CA cert, no external dependencies (browser will warn)
CERT_MODE=letsencrypt
CF_TOKEN=YOUR_CLOUDFLARE_TOKEN   # Zone:DNS:Edit for your domain — only needed for letsencrypt

# AI Gateway (optional) — set to true to install Envoy AI Gateway + OpenAI routing
INSTALL_AI_GATEWAY=false
# OPENAI_API_KEY=sk-...          # required when INSTALL_AI_GATEWAY=true

# Pinned component versions — defaults match config.ts, override here per-stack
ARGOCD_VERSION=9.5.15
ENVOY_GATEWAY_VERSION=v1.8.0
CILIUM_VERSION=1.19.4
CERT_MANAGER_VERSION=v1.20.2
KUBE_PROMETHEUS_STACK_VERSION=85.3.0
LOKI_VERSION=7.0.0
PROMTAIL_VERSION=6.17.1
